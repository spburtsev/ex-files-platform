DB_DSN=host=localhost user=admin password=admin dbname=exfiles port=5433 sslmode=disable TimeZone=UTC

JWT_SECRET=change-me-to-a-long-random-string

SEED_ROOT_EMAIL=root@example.com
SEED_ROOT_PASSWORD=change-me

# Create the demo accounts (password123). Local dev / integration tests only.
SEED_DEMO_USERS=true

# Session cookie Secure flag. Defaults to true; set to false only for
# plain-HTTP local setups.
COOKIE_SECURE=false

MINIO_ENDPOINT=localhost:9002
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
REDIS_ADDR=localhost:6380

# Resend email (leave RESEND_API_KEY empty for dev-mode logging)
RESEND_API_KEY=x
RESEND_FROM=ex-files <noreply@ex-files.dev>
